      "seed": 267664379,
      "version": 467,
      "versionNonce": 1454165403,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788450493491,
      "link": null,
      "locked": false,
      "text": "Each step is kept, by the way.\nWe need them for calculations.\nAll the path can be reproduced.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each step is kept, by the way.\nWe need them for calculations.\nAll the path can be reproduced.",
