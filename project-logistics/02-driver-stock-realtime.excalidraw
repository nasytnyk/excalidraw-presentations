      "boundElements": null,
      "updated": 1788450498436,
      "link": null,
      "locked": false,
      "text": "As we got mobile app sending location, we need some magic.\nBroadcast it real-time to user interface, and save to DB.\nAnd of course, ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As we got mobile app sending location, we need some magic.\nBroadcast it real-time to user interface, and save to DB.\nAnd of course, ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gHcr87cCYnF_XEwGfUnki",
      "type": "text",
      "x": 752.4574117662154,
      "y": -1619.4395081757407,
      "width": 305.29974365234375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
