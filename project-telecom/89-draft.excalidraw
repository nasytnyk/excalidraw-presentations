      "seed": 1102162617,
      "version": 176,
      "versionNonce": 2072378199,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788087580000,
      "link": null,
      "locked": false,
      "text": "TariffQuota (TariffId, QuotaGB)\n-- 3 рядки, бо тарифів було мало:\n--   PLAN_A, 50\n--   PLAN_B, 100\n--   PLAN_C, 150",
