      "seed": 12316926,
      "version": 2432,
      "versionNonce": 241000192,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788270656392,
      "link": null,
      "locked": false,
      "text": "Why SQL Managed Instance, not Azure SQL DB?\n- As it works all the time, no gain from serverless\n- SQL Agent is kept, not switching to Elastic Jobs\n- Stored procedures are kept, no need to rewrite\n- Backup with LRS is simpler on infrastructure ",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why SQL Managed Instance, not Azure SQL DB?\n- As it works all the time, no gain from serverless\n- SQL Agent is kept, not switching to Elastic Jobs\n- Stored procedures are kept, no need to rewrite\n- Backup with LRS is simpler on infrastructure ",
      "autoResize": false,
      "lineHeight": 1.35
    },
