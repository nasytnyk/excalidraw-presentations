    {
      "id": "qA_CEvmOrQt1nfwGWi5W1",
      "type": "text",
      "x": 1009.319617850382,
      "y": 1264.7597978470294,
      "width": 445.19534741681235,
      "height": 135,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b36V",
