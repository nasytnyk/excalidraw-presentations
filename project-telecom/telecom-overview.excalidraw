      "link": null,
      "locked": false,
      "text": "PROBLEM:\nDirect mediation to Azure Event Hubs is possible with Kafka endpoint.\nBut legacy billing system depends on CSVs, this part is not changing.\nSo in any case, we have to use forwarder, despite of will to simplify.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PROBLEM:\nDirect mediation to Azure Event Hubs is possible with Kafka endpoint.\nBut legacy billing system depends on CSVs, this part is not changing.\nSo in any case, we have to use forwarder, despite of will to simplify.\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
