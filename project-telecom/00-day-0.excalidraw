      "isDeleted": false,
      "boundElements": null,
      "updated": 1788035448340,
      "link": null,
      "locked": false,
      "text": "Prepaid users are just blocked when their traffic limit is exceeded.\nBut postpaid are not. They are treated as special in business logic.\nSo for postpaid users, system collects amounts of traffic consumed.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prepaid users are just blocked when their traffic limit is exceeded.\nBut postpaid are not. They are treated as special in business logic.\nSo for postpaid users, system collects amounts of traffic consumed.",
      "autoResize": false,
      "lineHeight": 1.25
    },
