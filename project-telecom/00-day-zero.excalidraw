    {
      "id": "BDZJ3DaOZeSnGF0uwH2xN",
      "type": "text",
      "x": 382.79461802040294,
      "y": -35.73888339331461,
      "width": 949.2746691917033,
      "height": 105,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2qriw6yJ_mFfyYRTnTD3m",
        "4kILN285uH8irlV3bA3OU"
      ],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1507065392,
      "version": 3806,
      "versionNonce": 1635478836,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788096904706,
      "link": null,
      "locked": false,
      "text": "Prepaid users are just blocked when their traffic limit is exceeded.\nBut postpaid are not. They are special. Only after human decision.\nSo for postpaid users, system collects amounts of traffic consumed.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prepaid users are just blocked when their traffic limit is exceeded.\nBut postpaid are not. They are special. Only after human decision.\nSo for postpaid users, system collects amounts of traffic consumed.",
      "autoResize": false,
      "lineHeight": 1.25
    },
