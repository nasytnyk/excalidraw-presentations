      "seed": 189408017,
      "version": 1799,
      "versionNonce": 1303719751,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787861388638,
      "link": null,
      "locked": false,
      "text": "Line of Accounting (LOA): born in 1956, still used in US bureaucracy.\nConditional space-escaped format, primarily suitable for mainframes.\nDescribes expenses: appropriation, cost center, patient ID, etc.\nNeeds a whole bunch of <if> statements for each specific context.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Line of Accounting (LOA): born in 1956, still used in US bureaucracy.\nConditional space-escaped format, primarily suitable for mainframes.\nDescribes expenses: appropriation, cost center, patient ID, etc.\nNeeds a whole bunch of <if> statements for each specific context.",
      "autoResize": false,
      "lineHeight": 1.25
    },
