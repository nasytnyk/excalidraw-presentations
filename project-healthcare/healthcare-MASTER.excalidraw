    {
      "id": "aBCzIWfbVnjzJs2HLkXzO",
      "type": "text",
      "x": 1356.3257700457068,
      "y": 1032.2033348540085,
      "width": 443.5159774577622,
      "height": 100,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "HnReaYNFsdFYApojw8kqI",
        "4bq0551jEX8Egp6xi3dVy"
      ],
      "frameId": null,
      "index": "b3G",
      "roundness": null,
      "seed": 744538495,
      "version": 3440,
      "versionNonce": 1902435740,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787846700989,
      "link": null,
      "locked": false,
      "text": "Old school \"*.rpt\" templates have SQL inside.\nIt results in vast subqueries for each metric.\n25 subqueries are OK when DB is small.\nThen - long polling and eating client RAM.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Old school \"*.rpt\" templates have SQL inside.\nIt results in vast subqueries for each metric.\n25 subqueries are OK when DB is small.\nThen - long polling and eating client RAM.",
      "autoResize": false,
      "lineHeight": 1.25
    },
