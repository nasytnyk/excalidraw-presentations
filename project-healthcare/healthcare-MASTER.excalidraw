    {
      "id": "kRGE5ZbSu8eQNN3VIag9Y",
      "type": "text",
      "x": 1366.0574232693314,
      "y": 1485.5334762990367,
      "width": 423.48138876386076,
      "height": 100,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "3_dprTN4b_U8T6zpdDzgT",
