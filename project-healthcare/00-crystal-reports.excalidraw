      "boundElements": [],
      "updated": 1787859953219,
      "link": null,
      "locked": false,
      "text": "Old school \"*.rpt\" templates have SQL inside.\nIt results in vast subqueries for each metric.\n25 subqueries are OK when DB is small.\nThen - long polling and eating client RAM.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Old school \"*.rpt\" templates have SQL inside.\nIt results in vast subqueries for each metric.\n25 subqueries are OK when DB is small.\nThen - long polling and eating client RAM.",
      "autoResize": false,
      "lineHeight": 1.25
    },
